# ============================================================
# PETENG BACKEND - contoh konfigurasi
# Salin nilai yang relevan ke file .env (jangan commit .env).
# ============================================================

PORT=8080

# development | production
# Di production, kode verifikasi TIDAK ditampilkan di response API.
APP_ENV=development

# PostgreSQL Supabase (connection string dari Project Settings > Database)
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# JWT
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRE_HOURS=24

# ============================================================
# EMAIL VERIFIKASI (SMTP Gmail)
# ============================================================
# Gmail: aktifkan 2FA lalu buat App Password 16 karakter.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=alamatkamu@gmail.com
SMTP_PASSWORD=app-password-16-karakter
SMTP_FROM=alamatkamu@gmail.com
SMTP_FROM_NAME=PETENG

APP_NAME=PETENG

# URL yang dipakai tombol "Verifikasi lewat link" di email.
# Harus bisa diakses dari HP (pakai IP LAN laptop, bukan 127.0.0.1).
APP_VERIFY_URL=http://10.0.172.83:8080/api/warga/verify-email

# ============================================================
# GOOGLE SIGN-IN
# ============================================================
# Web Client ID dari Google Cloud Console.
# Bisa lebih dari satu, pisahkan dengan koma.
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# ============================================================
# LAIN-LAIN
# ============================================================
AI_SERVICE_URL=http://127.0.0.1:8000
